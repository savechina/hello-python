#!/usr/bin/env bash
# Hello Python CLI entry point
#
# Usage:
#   bin/hello greet "World"
#   bin/hello user "Alice"
#   bin/hello agent status
#   bin/hello fastapi status
#
# Or install the package and use `hello` directly:
#   uv sync
#   hello greet "World"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# `uv run` resolves (and re-syncs) the project environment from
# .python-version + uv.lock, then executes the `hello` entry point defined in
# pyproject.toml. This avoids depending on a hand-managed .venv interpreter,
# which breaks whenever the underlying Python loses its OpenSSL linkage.
if ! command -v uv >/dev/null 2>&1; then
    echo "error: 'uv' is required. Install it with: brew install uv" >&2
    exit 127
fi

exec uv run --project "$PROJECT_ROOT" hello "$@"
