#!/bin/bash
# Hello Python CLI entry point
#
# Usage:
#   bin/hello greet "World"
#   bin/hello user "Alice"
#   bin/hello agent status
#   bin/hello fastapi status
#
# Or install the package and use `hello` directly:
#   uv sync
#   hello greet "World"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Use venv Python if available, otherwise fall back to uv run
if [ -f "$PROJECT_ROOT/.venv/bin/python" ]; then
    exec "$PROJECT_ROOT/.venv/bin/python" \
        -c "
import sys, os
sys.path.insert(0, '$PROJECT_ROOT')
from hello_python.cli import cli
cli(prog_name='hello')
" "$@"
else
    exec uv run --project "$PROJECT_ROOT" -c "
import sys, os
sys.path.insert(0, '$PROJECT_ROOT')
from hello_python.cli import cli
cli(prog_name='hello')
" "$@"
fi
